# ---------------------------------------------------------------------------
# NEXORA HOTEL OS — environment (Supabase backend)
# ---------------------------------------------------------------------------
# Copy to `.env` (git-ignored) and fill in. Values come from your Supabase
# project: Dashboard → Project Settings → API.
#
# REQUIRED: while these values are empty or still placeholders the app shows
# the "Connect your Supabase project" setup screen and every API route answers
# 503. There is no offline/demo backend. See docs/supabase-setup.md.
# ---------------------------------------------------------------------------

# --- Server -----------------------------------------------------------------
PORT=3000
# 'production' serves dist/; anything else runs Vite in middleware mode.
NODE_ENV=development

# --- Supabase ---------------------------------------------------------------
# Project URL, e.g. https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# anon/public key — SAFE to ship to the browser; access is protected by RLS.
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# service_role key — SERVER ONLY. Bypasses RLS. NEVER prefix with VITE_ and
# NEVER expose to the client. Used by server.ts for admin auth + guest sessions.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- First super admin ------------------------------------------------------
# Provision the first super admin after applying the schema:
#   npm run create-super-admin -- --email you@example.com
# (prompts for / generates a password). Supabase has no custom claims — the
# role is a `profiles` row written by the script with the service-role key.

# --- Vite -------------------------------------------------------------------
# Set to 'true' in agent/AI-Studio environments to disable HMR + file watching.
# DISABLE_HMR=false

# ---------------------------------------------------------------------------
# DESKTOP EDITION (offline distribution — Marg-style)
# ---------------------------------------------------------------------------
# The seller site (this repo, cloud mode) signs desktop activations with the
# PRIVATE key below; the desktop app verifies them with the PUBLIC key.
#
#   npm run keys:generate        # writes keys/license-signing-*.pem
#   npm run license:issue -- ... # CLI: issue a licence offline (no website)

# --- Licensing (hosted/seller server only) ---------------------------------
# Ed25519 private key (PKCS8 PEM). Leave empty if keys/ files are used.
# LICENSE_SIGNING_PRIVATE_KEY=

# Public key PEM embedded in desktop builds (or keep the constant in
# server/local/licensing.ts). The Electron build reads LICENSE_PUBLIC_KEY
# only at build time — bake it for production.
# LICENSE_PUBLIC_KEY=

# AES-256-GCM key used to encrypt customer passwords so the seller can
# re-share them (32+ chars; ANY strong passphrase).
# LICENSE_PASSWORD_KEY=

# --- Desktop build / download page ----------------------------------------
# 'local' = this build IS the Desktop Edition (set automatically by
# `npm run build:local` / `npm run dev:local`).
# VITE_RUNTIME=local

# Where the public /download page points for the Windows installer.
# VITE_DESKTOP_DOWNLOAD_URL=https://your-cdn.example.com/NexoraHotelOS-Setup-1.0.0.exe

# Local server runtime ------------------------------------------------------
# NEXORA_DATA_DIR=.nexora-data      # where the offline database lives
# NEXORA_LAN=1                       # bind 0.0.0.0 so guest phones on the
#                                    # hotel Wi-Fi can reach the QR portal
