# ---------------------------------------------------------------------------
# NEXORA HOTEL OS — environment
# ---------------------------------------------------------------------------
# NOTE: there are deliberately NO credentials in this repository.
#
#   • The Firebase *web* config lives in firebase-applet-config.json (these
#     values are public by design — security comes from the Firestore/Storage
#     rules, not from hiding them).
#   • The super admin account is created with a one-off script you run by
#     hand; its email/password are passed at run time and never stored here.
#     See docs/super-admin-setup.md
#
# Copy this file to .env for local overrides (.env* is git-ignored).
# ---------------------------------------------------------------------------

# --- Server -----------------------------------------------------------------
# Express port for server.ts (dev server + production bundle). Default: 3000.
PORT=3000

# 'production' serves dist/ and skips the Vite middleware. Anything else runs
# Vite in middleware mode for local development.
NODE_ENV=development

# --- Firebase Admin SDK (server.ts, scripts/) -------------------------------
# Path to a service-account JSON with Firebase Auth Admin + Datastore access.
# If unset, the Admin SDK falls back to Application Default Credentials
# (e.g. `gcloud auth application-default login`).
GOOGLE_APPLICATION_CREDENTIALS=/secure/path/to/service-account.json

# Optional: overrides the project id from firebase-applet-config.json.
# FIREBASE_PROJECT_ID=your-project-id

# --- Super admin provisioning (scripts/create-super-admin.ts) ---------------
# NEVER commit real values. These are read by the CLI script at run time from
# your shell / secret manager; prefer passing them as flags, or let the script
# generate a random password for you:
#   npm run create-super-admin -- --email you@example.com
# SUPER_ADMIN_EMAIL=
# SUPER_ADMIN_PASSWORD=

# --- Vite -------------------------------------------------------------------
# Set to 'true' in agent/AI-Studio environments to disable HMR + file watching.
# DISABLE_HMR=false
