{
  "name": "nexora-hotel-os",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "dev:local": "cross-env NEXORA_RUNTIME=local VITE_RUNTIME=local tsx server.ts",
    "dev:desktop": "electron .",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "build:local": "cross-env VITE_RUNTIME=local vite build && esbuild server/local/index.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server-local.cjs",
    "start": "node dist/server.cjs",
    "start:local": "cross-env NEXORA_START_LOCAL_SERVER=1 NODE_ENV=production node dist/server-local.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js desktop/release",
    "create-super-admin": "tsx scripts/create-super-admin.ts",
    "db:reset": "supabase db reset",
    "db:push": "supabase db push",
    "lint": "tsc --noEmit",
    "check:dates": "tsx scripts/check-dates.ts",
    "keys:generate": "tsx scripts/generate-license-keys.ts",
    "license:issue": "tsx scripts/issue-license.ts",
    "smoke:local": "tsx scripts/smoke-local.ts",
    "desktop:pack": "npm run build:local && electron-builder --win"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@supabase/supabase-js": "^2.112.4",
    "@tailwindcss/vite": "^4.1.14",
    "@types/canvas-confetti": "^1.9.0",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-react": "^5.0.4",
    "canvas-confetti": "^1.9.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3",
    "better-sqlite3": "^11.10.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12",
    "cross-env": "^7.0.3"
  },
  "description": "NEXORA Hotel OS — hosted (cloud) and desktop (offline) hotel management",
  "main": "desktop/main.cjs",
  "build": {
    "appId": "in.nexora.hotelos",
    "productName": "NEXORA Hotel OS",
    "copyright": "Copyright © 2026 NEXORA",
    "asar": true,
    "directories": {
      "output": "desktop/release"
    },
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "desktop/icon.png",
      "artifactName": "NexoraHotelOS-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "NEXORA Hotel OS",
      "perMachine": false
    }
  }
}
