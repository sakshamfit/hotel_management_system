rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isAuthenticated() && 
        request.auth.token.role == 'super_admin';
    }

    function isHotelAdmin(hotelId) {
      return isAuthenticated() && 
        (
          request.auth.token.role == 'super_admin' || 
          (request.auth.token.role == 'hotel_admin' && request.auth.token.hotelId == hotelId)
        );
    }

    // users collection — marker documents for admin accounts.
    // Public read is required so the one-time super admin bootstrap can check,
    // BEFORE anyone signs in, whether a super_admin already exists. These docs
    // contain only { role, email, createdAt } and grant NO data access — all
    // authorization is custom-claims based (see isSuperAdmin / isHotelAdmin).
    match /users/{uid} {
      allow get, list: if true;
      allow create: if isAuthenticated()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['role', 'email', 'createdAt'])
        && request.resource.data.role is string
        && request.resource.data.email is string;
      allow update, delete: if isSuperAdmin();
    }

    // Hotel documents
    match /hotels/{hotelId} {
      // Super admin has full read/write on all hotels
      // Hotel admin can read and update their own hotel profile
      allow read: if isSuperAdmin() || isHotelAdmin(hotelId);
      allow create, delete: if isSuperAdmin();
      allow update: if isSuperAdmin() || isHotelAdmin(hotelId);

      // All subcollections under a specific hotel
      match /{subcollection}/{document=**} {
        allow read, write: if isHotelAdmin(hotelId);
      }
    }

    // Default deny all other collections
    match /{document=**} {
      allow read, write: if isSuperAdmin();
    }
  }
}
