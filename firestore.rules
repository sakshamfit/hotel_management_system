rules_version = '2';

// ===========================================================================
// NEXORA HOTEL OS — Firestore security rules
// ===========================================================================
// Three caller classes:
//
//   1. super_admin  — platform owner. Custom claim OR users/{uid} role doc.
//   2. hotel_admin  — one tenant. Custom claim OR users/{uid} role doc.
//   3. guest        — anonymous Firebase Auth user holding a SERVER-ISSUED
//                     claim { role:'guest', hotelId, roomId, roomNumber },
//                     granted by POST /api/guest/session after a room QR scan.
//
// Guests are scoped to their own hotel, their own room, and their own orders.
// They can never read or write staff data, other rooms (which carry other
// guests' names and phone numbers), or another guest's orders.
//
// Document-access budget: rules allow 10 get()/exists() calls per
// single-document evaluation (20 for queries). isStaffOf() and isSuperAdmin()
// are written so each one performs its reads inside a single short-circuited
// expression, and guest checks are evaluated FIRST (zero reads) so anonymous
// callers never reach the Firestore lookup at all.
//
// Deploy with:  firebase deploy --only firestore:rules
// (a firebase.json is required — see docs/super-admin-setup.md)
// ===========================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------------
    // Helpers
    // ---------------------------------------------------------------------

    function isAuthenticated() {
      return request.auth != null;
    }

    function userPath() {
      // Only ever call this after isAuthenticated() has been checked.
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    /**
     * Super admin: custom claim (Admin SDK) or role document.
     *
     * Guarded with exists() — the previous `get(...).data` form threw for any
     * caller without a role document (i.e. every anonymous guest), which
     * turned the whole rule into an error-deny and blocked guest access
     * entirely.
     */
    function isSuperAdmin() {
      return isAuthenticated()
        && (
          request.auth.token.role == 'super_admin'
          || (
            exists(userPath())
            && 'role' in get(userPath()).data
            && get(userPath()).data.role == 'super_admin'
          )
        );
    }

    /** Staff of one tenant: super admin, or that hotel's admin. */
    function isStaffOf(hotelId) {
      return isAuthenticated()
        && (
          request.auth.token.role == 'super_admin'
          || (request.auth.token.role == 'hotel_admin' && request.auth.token.hotelId == hotelId)
          || (
            exists(userPath())
            && 'role' in get(userPath()).data
            && (
              get(userPath()).data.role == 'super_admin'
              || (
                get(userPath()).data.role == 'hotel_admin'
                && 'hotelId' in get(userPath()).data
                && get(userPath()).data.hotelId == hotelId
              )
            )
          )
        );
    }

    /**
     * Anonymous guest scoped to this hotel by a server-issued claim.
     * Custom claims cannot be set from the client, so this is not spoofable.
     */
    function isGuestOf(hotelId) {
      return isAuthenticated()
        && request.auth.token.role == 'guest'
        && request.auth.token.hotelId == hotelId;
    }

    function guestRoomId() {
      return isAuthenticated() && 'roomId' in request.auth.token
        ? request.auth.token.roomId
        : null;
    }

    // ---------------------------------------------------------------------
    // users — role documents
    // ---------------------------------------------------------------------
    // FIXED: this was `allow get, list: if true` (readable by anyone, including
    // unauthenticated callers) and `allow create` let any signed-in caller
    // write their OWN document with an arbitrary role — a direct path to
    // self-granting super_admin. Both holes are closed:
    //   • read  → your own document only (or a super admin)
    //   • list  → super admin
    //   • write → super admin only
    // Role documents are now created exclusively by the Admin SDK
    // (server.ts) or scripts/create-super-admin.ts, both of which bypass
    // rules entirely.
    match /users/{uid} {
      allow get: if isAuthenticated() && (request.auth.uid == uid || isSuperAdmin());
      allow list: if isSuperAdmin();
      allow create, update, delete: if isSuperAdmin();
    }

    // ---------------------------------------------------------------------
    // hotels — tenants
    // ---------------------------------------------------------------------
    match /hotels/{hotelId} {
      // A guest may read the profile of their own hotel (name, branding,
      // currency). Listing tenants and every write stay staff-only.
      allow get: if isGuestOf(hotelId) || isStaffOf(hotelId);
      allow list: if isSuperAdmin();
      allow create, delete: if isSuperAdmin();
      allow update: if isStaffOf(hotelId);

      // ---- rooms ---------------------------------------------------------
      // Room documents carry guestName / guestPhone / guestEmail, so a guest
      // may read ONLY their own room, as a single-document read. Listing is
      // staff-only — that is what keeps other guests' PII away from a guest.
      match /rooms/{roomId} {
        allow get: if (isGuestOf(hotelId) && roomId == guestRoomId()) || isStaffOf(hotelId);
        allow list: if isStaffOf(hotelId);
        allow write: if isStaffOf(hotelId);
      }

      // ---- menu & services -----------------------------------------------
      // Public to anyone staying at, or working at, this property.
      match /foodItems/{itemId} {
        allow read: if isGuestOf(hotelId) || isStaffOf(hotelId);
        allow write: if isStaffOf(hotelId);
      }
      match /services/{serviceId} {
        allow read: if isGuestOf(hotelId) || isStaffOf(hotelId);
        allow write: if isStaffOf(hotelId);
      }

      // ---- orders ---------------------------------------------------------
      // A guest creates their own orders and reads the ones they authored
      // (guestUid == their anonymous uid). Status transitions, assignment and
      // cancellation are staff-only — a guest can never mark an order
      // COMPLETED themselves.
      //
      // Allowed guest fields are whitelisted with hasOnly() so a guest cannot
      // smuggle in staff-only fields (assignedStaffId, priority, status...).
      match /orders/{orderId} {
        allow get: if (isGuestOf(hotelId) && resource.data.guestUid == request.auth.uid)
                   || isStaffOf(hotelId);
        // NOTE: rules cannot inspect a query's where() filters, so the guest
        // order LIST is scoped to the tenant here and to the caller by the
        // client query (where('guestUid','==',uid)). See
        // docs/super-admin-setup.md ("Known limitation") for the airtight
        // variant if you need it before the reservation rebuild.
        allow list: if isGuestOf(hotelId) || isStaffOf(hotelId);
        allow create: if isStaffOf(hotelId)
                      || (
                        isGuestOf(hotelId)
                        && request.resource.data.keys().hasOnly([
                             'roomId', 'roomNumber', 'guestUid', 'guestName',
                             'type', 'items', 'totalAmount', 'status',
                             'instructions', 'createdAt'
                           ])
                        && request.resource.data.guestUid == request.auth.uid
                        && request.resource.data.roomId == guestRoomId()
                        && request.resource.data.type in ['food', 'service']
                        && request.resource.data.status == 'PENDING'
                      );
        allow update, delete: if isStaffOf(hotelId);
      }

      // ---- reservations: staff-only --------------------------------------
      // Guests have NO access to any of these, directly or indirectly. They
      // interact only through `orders` (already scoped above); the server
      // raises folio charges on their behalf with the Admin SDK.
      //
      // Guests in particular must never read:
      //   • bookings / guests — other people's names, phones and ID proofs
      //   • roomNights        — the occupancy map for the whole property
      //   • folios / charges  — another guest's bill
      match /guests/{guestId} {
        allow read, write: if isStaffOf(hotelId);
      }
      match /roomTypes/{typeId} {
        allow read, write: if isStaffOf(hotelId);
      }
      match /roomNights/{nightId} {
        allow read, write: if isStaffOf(hotelId);
      }
      match /bookings/{bookingId} {
        allow read, write: if isStaffOf(hotelId);
      }
      match /folios/{folioId} {
        allow read, write: if isStaffOf(hotelId);
        match /charges/{chargeId} {
          allow read, write: if isStaffOf(hotelId);
        }
        match /payments/{paymentId} {
          allow read, write: if isStaffOf(hotelId);
        }
      }

      // ---- everything else under a hotel (staff, future collections)
      match /{subcollection}/{document=**} {
        allow read, write: if isStaffOf(hotelId);
      }
    }

    // ---------------------------------------------------------------------
    // Default deny for any other collection
    // ---------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if isSuperAdmin();
    }
  }
}
