rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    // Read the caller's role document (users/{request.auth.uid}).
    // Used as the PRIMARY role source (free-tier, no custom claims required).
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Super Admin: custom claim (legacy / Admin SDK fallback) OR Firestore role doc
    function isSuperAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'super_admin' ||
        getUserData().role == 'super_admin'
      );
    }

    // Hotel Admin of a given hotel: custom claim (legacy) OR Firestore users doc
    function isHotelAdminOf(hotelId) {
      return isAuthenticated() && (
        request.auth.token.role == 'super_admin' ||
        (request.auth.token.role == 'hotel_admin' && request.auth.token.hotelId == hotelId) ||
        (getUserData().role == 'hotel_admin' && getUserData().hotelId == hotelId)
      );
    }

    // users collection — role documents (free-tier primary role source).
    // Public read is required so the one-time super admin bootstrap can check,
    // BEFORE anyone signs in, whether a super_admin already exists; role
    // lookups also read these docs. The docs themselves grant NO data access —
    // all authorization is evaluated via isSuperAdmin()/isHotelAdminOf() above.
    // Writes: a user may create ONLY their own marker doc (typed fields),
    // e.g. the secondary-app hotel-admin signup and the first super admin
    // bootstrap. Everything else is super-admin only.
    match /users/{uid} {
      allow get, list: if true;
      allow create: if isSuperAdmin() || (
        isAuthenticated()
        && request.auth.uid == uid
        && request.resource.data.role is string
        && request.resource.data.email is string
      );
      allow update, delete: if isSuperAdmin();
    }

    // Hotel documents
    match /hotels/{hotelId} {
      // Super admin has full read/write on all hotels
      // Hotel admin can read and update their own hotel profile
      allow read: if isSuperAdmin() || isHotelAdminOf(hotelId);
      allow create, delete: if isSuperAdmin();
      allow update: if isSuperAdmin() || isHotelAdminOf(hotelId);

      // All subcollections under a specific hotel
      match /{subcollection}/{document=**} {
        allow read, write: if isSuperAdmin() || isHotelAdminOf(hotelId);
      }
    }

    // Default deny all other collections
    match /{document=**} {
      allow read, write: if isSuperAdmin();
    }
  }
}
